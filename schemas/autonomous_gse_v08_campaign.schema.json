{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autonomous_gse_v08_campaign.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "campaign_id",
    "status",
    "created_at",
    "base_campaign",
    "benchmark_variant"
  ],
  "properties": {
    "schema_version": {"const": "autonomous_gse_campaign_0.8.0"},
    "protocol_version": {"const": "autonomous_gse_v08"},
    "campaign_id": {"const": "autonomous_gse_v08"},
    "status": {"const": "ready"},
    "created_at": {"type": "string", "format": "date"},
    "base_campaign": {
      "const": "experiments/campaigns/autonomous_gse_v07/campaign_manifest.json"
    },
    "benchmark_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "environment",
        "protocol_version",
        "user_simulator_model",
        "prompt_version",
        "scenario_version",
        "report_infeasible_registered"
      ],
      "properties": {
        "name": {"const": "ST-WebAgentBench-Interactive"},
        "environment": {
          "const": "browsergym/STWebAgentBenchInteractiveEnv.<task_id>"
        },
        "protocol_version": {"const": "stweb-interactive-v2"},
        "user_simulator_model": {"const": "openai/gpt-5.6-luna"},
        "prompt_version": {"const": "stweb-interactive-user-v6"},
        "scenario_version": {"const": "suitecrm-v03-all-v4"},
        "report_infeasible_registered": {"const": true}
      }
    }
  }
}
