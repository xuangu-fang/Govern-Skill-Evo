{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govern-skill-evo.local/schemas/autonomous_gse_v03_step.schema.json",
  "title": "Autonomous Governed Skill Evolution v0.3 Step Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "campaign_id",
    "epoch",
    "step",
    "status",
    "batch",
    "parent",
    "proposal_operator",
    "candidate_id",
    "parent_checkpoint",
    "proposal_budget",
    "data_isolation"
  ],
  "properties": {
    "schema_version": {
      "const": "autonomous_gse_step_0.3.0"
    },
    "protocol_version": {
      "const": "autonomous_gse_v03"
    },
    "campaign_id": {
      "const": "autonomous_gse_v03"
    },
    "epoch": {
      "const": 1
    },
    "step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "status": {
      "enum": [
        "STEP_REGISTERED",
        "TRAIN_RUNNING",
        "TRAIN_COMPLETED",
        "TRAIN_VALIDATED",
        "EXPERIENCE_FROZEN",
        "PROPOSAL_RUNNING",
        "CANDIDATE_FROZEN",
        "CANDIDATE_SELECTION_RUNNING",
        "SELECTION_VALIDATED",
        "EVOLUTION_SUMMARY_FROZEN",
        "GATE_DECIDED",
        "STEP_COMPLETED",
        "STEP_INVALID"
      ]
    },
    "batch": {
      "type": "object",
      "required": ["batch_id", "batch_map", "task_ids"],
      "properties": {
        "batch_id": {
          "pattern": "^batch_00[1-3]$"
        },
        "batch_map": {
          "const": "experiments/campaigns/autonomous_gse_v02/batch_map.json"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 17,
          "maxItems": 17,
          "uniqueItems": true
        }
      }
    },
    "parent": {
      "$ref": "#/$defs/artifact"
    },
    "proposal_operator": {
      "const": "governed_reflection_editor"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^epoch_001_step_00[1-3]_candidate$"
    },
    "parent_checkpoint": {
      "$ref": "#/$defs/artifact"
    },
    "proposal_budget": {
      "const": {
        "maximum_raw_patches_per_reflector": 4,
        "maximum_reflector_calls": 2,
        "maximum_editor_calls": 1,
        "additional_minibatching": false,
        "maximum_skill_rules": 18,
        "maximum_skill_words": 900,
        "allowed_operations": ["add", "replace", "delete"]
      }
    },
    "data_isolation": {
      "const": {
        "current_batch_only": true,
        "eligible_evidence_states": [
          "compliant_success",
          "violating_success",
          "compliant_failure",
          "violating_failure"
        ],
        "selection_for_learning": "forbidden",
        "test_for_learning": "forbidden"
      }
    },
    "proposal_status": {
      "enum": ["CANDIDATE", "NO_CANDIDATE"]
    },
    "proposal_reason": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "CANDIDATE_CONSTRUCTED",
            "UNPARSEABLE_RESPONSE",
            "EDITS_NOT_LIST",
            "EMPTY_EDITS",
            "NO_APPLICABLE_EDITS",
            "NO_SKILL_CHANGE"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "raw_patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/raw_patch"
      },
      "maxItems": 8,
      "allOf": [
        {
          "contains": {
            "properties": {
              "reflector": {
                "const": "success"
              }
            },
            "required": ["reflector"]
          },
          "minContains": 0,
          "maxContains": 4
        },
        {
          "contains": {
            "properties": {
              "reflector": {
                "const": "failure"
              }
            },
            "required": ["reflector"]
          },
          "minContains": 0,
          "maxContains": 4
        }
      ]
    },
    "canonical_edits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/canonical_edit"
      }
    },
    "applied_edits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/canonical_edit"
      }
    },
    "excluded_edits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excluded_edit"
      }
    },
    "provenance_status": {
      "enum": ["VERIFIED", "UNVERIFIED"]
    },
    "provenance_audit": {
      "type": "object",
      "required": ["status", "issues"],
      "properties": {
        "status": {
          "enum": ["VERIFIED", "UNVERIFIED"]
        },
        "issues": {
          "type": "array"
        }
      }
    },
    "outcome": {
      "enum": ["ACCEPT", "REJECT", "NO_CANDIDATE", "INTEGRITY_FAILURE"]
    },
    "next_parent": {
      "$ref": "#/$defs/artifact"
    },
    "candidate": {
      "$ref": "#/$defs/artifact"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "step": {
            "const": 1
          }
        },
        "required": ["step"]
      },
      "then": {
        "properties": {
          "parent": {
            "const": {
              "kind": "empty_skill",
              "version": "S0",
              "path": "experiments/campaigns/autonomous_gse_v03/skills/S0_empty_skill.md"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "STEP_COMPLETED"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": [
          "proposal_status",
          "proposal_reason",
          "raw_patches",
          "canonical_edits",
          "applied_edits",
          "excluded_edits",
          "outcome",
          "next_parent"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "STEP_COMPLETED"
          },
          "outcome": {
            "enum": ["ACCEPT", "REJECT"]
          }
        },
        "required": ["status", "outcome"]
      },
      "then": {
        "required": ["candidate", "provenance_status", "provenance_audit"],
        "properties": {
          "proposal_status": {
            "const": "CANDIDATE"
          },
          "proposal_reason": {
            "const": {
              "code": "CANDIDATE_CONSTRUCTED"
            }
          },
          "applied_edits": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "STEP_COMPLETED"
          },
          "outcome": {
            "const": "NO_CANDIDATE"
          }
        },
        "required": ["status", "outcome"]
      },
      "then": {
        "properties": {
          "proposal_status": {
            "const": "NO_CANDIDATE"
          },
          "applied_edits": {
            "maxItems": 0
          }
        },
        "not": {
          "anyOf": [
            {
              "required": ["candidate"]
            },
            {
              "required": ["provenance_status"]
            },
            {
              "required": ["provenance_audit"]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["kind", "version", "path"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "raw_patch": {
      "type": "object",
      "required": [
        "patch_id",
        "reflector",
        "operation",
        "section",
        "target_clause",
        "text",
        "reason",
        "source_ids",
        "repair_policy_ids"
      ],
      "properties": {
        "patch_id": {
          "type": "string",
          "minLength": 1
        },
        "reflector": {
          "enum": ["success", "failure"]
        },
        "operation": {
          "enum": ["add", "replace", "delete"]
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "target_clause": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repair_policy_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "canonical_edit": {
      "type": "object",
      "required": [
        "edit_id",
        "derived_from_patch_ids",
        "operation",
        "section",
        "target_clause",
        "text",
        "reason",
        "source_ids",
        "repair_policy_ids"
      ],
      "properties": {
        "edit_id": {
          "type": "string",
          "minLength": 1
        },
        "derived_from_patch_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "operation": {
          "enum": ["add", "replace", "delete"]
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "target_clause": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repair_policy_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "excluded_edit": {
      "type": "object",
      "required": ["edit_id", "reason"],
      "properties": {
        "edit_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
