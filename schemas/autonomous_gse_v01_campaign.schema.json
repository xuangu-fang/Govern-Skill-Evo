{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govern-skill-evo.local/schemas/autonomous_gse_v01_campaign.schema.json",
  "title": "Autonomous Governed Skill Evolution v0.1 Campaign Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "campaign_id",
    "status",
    "created_at",
    "completed_at",
    "initial_parent",
    "schedule",
    "train",
    "proposal",
    "selection",
    "gate",
    "step_outcomes",
    "budget",
    "test",
    "benchmark_runtime"
  ],
  "properties": {
    "schema_version": {
      "const": "autonomous_gse_campaign_0.1.0"
    },
    "protocol_version": {
      "const": "autonomous_gse_v01"
    },
    "campaign_id": {
      "const": "autonomous_gse_v01"
    },
    "status": {
      "const": "completed"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "initial_parent": {
      "const": {
        "kind": "no_skill",
        "version": "S0",
        "path": "experiments/campaigns/autonomous_gse_v01/skills/S0_no_skill.json"
      }
    },
    "schedule": {
      "const": {
        "epochs": 1,
        "steps_per_epoch": 3,
        "scheduled_steps": 3
      }
    },
    "train": {
      "const": {
        "source_manifest": "experiments/manifests/stweb_suitecrm_poc_v01.json",
        "source_split": "train",
        "total_tasks": 51,
        "intent_templates": 17,
        "batches": 3,
        "tasks_per_batch": 17,
        "tasks_per_template": 3,
        "template_balanced": true,
        "overlap_between_batches": 0,
        "assignment_source": "recorded_static_batch_map",
        "outcome_independent_assignment": true,
        "cumulative_evidence": false,
        "replay_previous_batches": false,
        "batch_map": "experiments/campaigns/autonomous_gse_v01/batch_map.json"
      }
    },
    "proposal": {
      "const": {
        "dispatch": {
          "no_skill_parent": "bootstrap",
          "accepted_skill_parent": "incremental"
        },
        "candidates_per_step": 1,
        "maximum_learner_calls": 3,
        "eligible_evidence_states": [
          "compliant_success",
          "violating_success"
        ],
        "selection_feedback_to_learner": "forbidden",
        "test_feedback_to_learner": "forbidden",
        "learner": {
          "model": "openai/gpt-5.6-terra",
          "parameters": {
            "reasoning_effort": "low",
            "max_completion_tokens": 8000,
            "temperature": null
          },
          "bootstrap_prompt": "src/learners/stwebagentbench/generate_governed_skill.py",
          "incremental_prompt": "src/learners/stwebagentbench/generate_governed_s2.py"
        }
      }
    },
    "selection": {
      "const": {
        "protocol": "accepted_parent_checkpoint",
        "tasks": 18,
        "initial_s0_checkpoint": "fresh",
        "candidate_selection_each_step": "fresh",
        "accepted_candidate_becomes_checkpoint": true,
        "rejected_candidate_keeps_checkpoint": true,
        "selection_data_for_learning": "forbidden"
      }
    },
    "gate": {
      "const": {
        "rule_set": "two_dimensional_evolution_gate_v01",
        "aggregate_metrics": [
          "task_success",
          "compliance",
          "cup"
        ],
        "accept_condition": "all_aggregate_deltas_nonnegative_and_at_least_one_positive",
        "severe_violation_action": "REJECT"
      }
    },
    "step_outcomes": {
      "const": [
        "ACCEPT",
        "REJECT",
        "NO_CANDIDATE",
        "INVALID_PROPOSAL",
        "INTEGRITY_FAILURE"
      ]
    },
    "budget": {
      "const": {
        "train_trajectories": 51,
        "initial_selection_trajectories": 18,
        "maximum_candidate_selection_trajectories": 54,
        "maximum_total_trajectories": 123,
        "maximum_candidates": 3,
        "maximum_learner_calls": 3,
        "unused_budget_reallocation": "forbidden"
      }
    },
    "test": {
      "const": {
        "authorized": false,
        "data_for_learning": "forbidden"
      }
    },
    "benchmark_runtime": {
      "const": {
        "benchmark": "ST-WebAgentBench",
        "agent_model": "openai/gpt-5.6-terra",
        "agent_parameters": {
          "temperature": 0.1,
          "max_tokens": 512
        },
        "rollout": {
          "headless": false,
          "trials_per_task": 1,
          "execution": "sequential",
          "database_reset_before_every_trial": true
        },
        "database_snapshot": "artifacts/stweb_suitecrm_poc_v01/db/suitecrm_pristine_v01.sql",
        "database_reset": "src/adapters/stwebagentbench/reset_suitecrm_db.sh",
        "compose_file": "external/ST-WebAgentBench/suitecrm_setup/docker-compose.yaml"
      }
    }
  }
}
