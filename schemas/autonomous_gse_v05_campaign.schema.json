{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autonomous_gse_v05_campaign.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "campaign_id",
    "campaign_seed",
    "headless",
    "execution",
    "parallel_workers",
    "train_rollouts_per_task",
    "selection_rollouts_per_task",
    "full_experiment_seeds",
    "rule_addressing",
    "status",
    "created_at",
    "base_campaign",
    "post_hoc_training_replay",
    "test",
    "budget"
  ],
  "properties": {
    "schema_version": {"const": "autonomous_gse_campaign_0.5.0"},
    "protocol_version": {"const": "autonomous_gse_v05"},
    "campaign_id": {"const": "autonomous_gse_v05"},
    "campaign_seed": {"type": "integer"},
    "headless": {"const": true},
    "execution": {"const": "parallel"},
    "parallel_workers": {"const": 4},
    "train_rollouts_per_task": {"type": "integer", "minimum": 1},
    "selection_rollouts_per_task": {"type": "integer", "minimum": 1},
    "full_experiment_seeds": {"const": 1},
    "rule_addressing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "legacy_target_clause_fallback",
        "ambiguous_legacy_match"
      ],
      "properties": {
        "mode": {"const": "stable_parent_rule_id"},
        "legacy_target_clause_fallback": {
          "const": "normalize_markdown_bullet_and_whitespace"
        },
        "ambiguous_legacy_match": {"const": "reject_edit"}
      }
    },
    "status": {"enum": ["draft", "ready"]},
    "created_at": {"type": "string", "format": "date"},
    "base_campaign": {
      "const": "experiments/campaigns/autonomous_gse_v03/campaign_manifest.json"
    },
    "post_hoc_training_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"const": false}}
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "data_for_learning"],
      "properties": {
        "authorized": {"const": false},
        "data_for_learning": {"const": "forbidden"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train_trajectories",
        "initial_selection_trajectories",
        "maximum_candidate_selection_trajectories",
        "maximum_total_trajectories",
        "maximum_candidates",
        "maximum_learner_calls",
        "unused_budget_reallocation"
      ],
      "properties": {
        "train_trajectories": {"type": "integer", "minimum": 51},
        "initial_selection_trajectories": {"type": "integer", "minimum": 18},
        "maximum_candidate_selection_trajectories": {"type": "integer", "minimum": 54},
        "maximum_total_trajectories": {"type": "integer", "minimum": 123},
        "maximum_candidates": {"const": 3},
        "maximum_learner_calls": {"const": 9},
        "unused_budget_reallocation": {"const": "forbidden"}
      }
    }
  }
}
