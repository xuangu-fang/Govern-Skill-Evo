+import os
+from pathlib import Path
+from typing import Optional
+
+from tau2.agent.llm_agent import LLMAgent
+from tau2.environment.tool import Tool
+
+SKILL_PATH_ENV = "TAU2_AGENT_SKILL_PATH"
+
+
+def load_skill_body(skill_path: str) -> str:
+    """Load a Skill Markdown body, excluding optional YAML frontmatter."""
+    text = Path(skill_path).expanduser().read_text(encoding="utf-8").strip()
+    if text.startswith("---"):
+        parts = text.split("---", 2)
+        if len(parts) != 3:
+            raise ValueError(f"Invalid Skill frontmatter in {skill_path}")
+        text = parts[2].strip()
+    if not text:
+        raise ValueError(f"Skill is empty: {skill_path}")
+    return text
+
+
+class ManualSkillAgent(LLMAgent):
+    """Standard text agent with an additional execution Skill."""
+
+    def __init__(
+        self,
+        tools: list[Tool],
+        domain_policy: str,
+        skill: str,
+        llm: str,
+        llm_args: Optional[dict] = None,
+    ):
+        super().__init__(
+            tools=tools,
+            domain_policy=domain_policy,
+            llm=llm,
+            llm_args=llm_args,
+        )
+        self.skill = skill
+
+    @property
+    def system_prompt(self) -> str:
+        return f"{super().system_prompt}\n<skill>\n{self.skill}\n</skill>"
+
+
+def create_manual_skill_agent(tools, domain_policy, **kwargs):
+    """Create an agent using an explicit Skill path or the environment fallback."""
+    llm_args = dict(kwargs.get("llm_args") or {})
+    skill_path = llm_args.pop("manual_skill_path", None) or os.environ.get(
+        SKILL_PATH_ENV
+    )
+    if not skill_path:
+        raise ValueError(f"{SKILL_PATH_ENV} must point to a SKILL.md file")
+    return ManualSkillAgent(
+        tools=tools,
+        domain_policy=domain_policy,
+        skill=load_skill_body(skill_path),
+        llm=kwargs.get("llm"),
+        llm_args=llm_args,
+    )
