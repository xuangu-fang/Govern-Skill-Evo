# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Third-party repositories and local data
external/*
!external/.gitkeep
data/raw/

# Generated and potentially large artifacts
/outputs/
/artifacts/
*.log

# Local scratch files
tmp/
scratch/

# Generated benchmark runtime artifacts
/benchmarks/tau2_governed_evolution/**/trajectories/
/benchmarks/tau2_governed_evolution/**/evaluations/
/benchmarks/tau2_governed_evolution/**/snapshots/
/benchmarks/tau2_governed_evolution/**/runtime/
/benchmarks/tau2_governed_evolution/**/executions/
/benchmarks/tau2_governed_evolution/**/raw_model_outputs/
/benchmarks/tau2_governed_evolution/**/runtime_payload_snapshots.json

# Keep reports and aggregate JSON summaries; ignore raw experiment run data.
/benchmarks/tau2_governed_evolution/**/experiments/**/run/**/*.json
/benchmarks/tau2_governed_evolution/**/experiments/**/run/**/*.jsonl
/benchmarks/tau2_governed_evolution/**/experiments/**/run/**/*.json.gz

# Reproducible rollout records and runtime databases outside those directories
/benchmarks/tau2_governed_evolution/**/*.jsonl
/benchmarks/tau2_governed_evolution/**/*_rollout_records.json
/benchmarks/tau2_governed_evolution/**/*_final_db.json
/benchmarks/tau2_governed_evolution/**/*_final_db.json.gz
/benchmarks/tau2_governed_evolution/**/*_tau2_raw.json
