# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Third-party repositories and local data
external/*
!external/.gitkeep
data/raw/

# Generated and potentially large artifacts
/outputs/
/artifacts/
*.log

# Experiment runtime artifacts. Keep only source inputs, manifests, human
# annotations, and curated reports under experiments/ in Git.
/experiments/v17_*/
/experiments/v18_*/
# v19 pilot runs, retries, request archives, and local launch metadata.
# Keep the report and implementation under docs/, scripts/, src/, and tests/.
/experiments/v19_v4_*
/experiments/.v19_v4_*.replay.lock
# Organized v17/v18 runtime trees; keep navigation outside raw runs.
/experiments/v17/pilot/*
!/experiments/v17/pilot/README.md
/experiments/v17/formal/*
!/experiments/v17/formal/README.md
/experiments/archive/v17/*
!/experiments/archive/v17/README.md
/experiments/v18/pilot/*
!/experiments/v18/pilot/README.md
/experiments/v18/formal/*
!/experiments/v18/formal/README.md
/experiments/archive/v18/*
!/experiments/archive/v18/README.md
# Organized v19 runtime trees; keep only top-level navigation and path maps.
/experiments/v19/pilot/*
!/experiments/v19/pilot/README.md
/experiments/v19/formal/*
!/experiments/v19/formal/README.md
/experiments/v19/archive/*
!/experiments/v19/archive/README.md
/experiments/archive/v19/*
!/experiments/archive/v19/README.md
# Locks can also be created next to relocated run directories.
/experiments/**/.*.replay.lock
/experiments/**/.*.campaign.lock
/experiments/.*.campaign.lock
/experiments/**/attempt*/
/experiments/**/semantic_runs/
/experiments/**/run_[0-9]*/
/experiments/**/task_diagnoses/
/experiments/**/learner_requests_sanitized/

# Local scratch files
tmp/
scratch/

# Generated benchmark runtime artifacts
/benchmarks/tau2_governed_evolution/**/trajectories/
/benchmarks/tau2_governed_evolution/**/evaluations/
/benchmarks/tau2_governed_evolution/**/snapshots/
/benchmarks/tau2_governed_evolution/**/runtime/
/benchmarks/tau2_governed_evolution/**/executions/
/benchmarks/tau2_governed_evolution/**/raw_model_outputs/
/benchmarks/tau2_governed_evolution/**/runtime_payload_snapshots.json

# Keep reports and aggregate JSON summaries; ignore raw experiment run data.
/benchmarks/tau2_governed_evolution/**/experiments/**/run/**/*.json
/benchmarks/tau2_governed_evolution/**/experiments/**/run/**/*.jsonl
/benchmarks/tau2_governed_evolution/**/experiments/**/run/**/*.json.gz

# Reproducible rollout records and runtime databases outside those directories
/benchmarks/tau2_governed_evolution/**/*.jsonl
/benchmarks/tau2_governed_evolution/**/*_rollout_records.json
/benchmarks/tau2_governed_evolution/**/*_final_db.json
/benchmarks/tau2_governed_evolution/**/*_final_db.json.gz
/benchmarks/tau2_governed_evolution/**/*_tau2_raw.json
