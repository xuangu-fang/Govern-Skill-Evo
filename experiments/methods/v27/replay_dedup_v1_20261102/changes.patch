+"""Read six historical requests, round-trip the new view, and audit isolation.
+
+This command never initializes a campaign, loads credentials or calls a model.
+Historical runs are measured as archived wire inputs, including their previously
+authorized recovery history; they are not resumed under the current contract.
+"""
+import argparse
+from contextlib import ExitStack
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import socket
+import sys
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path[:0] = [str(ROOT), str(ROOT/'external/SkillAdam')]
+
+
+def encoded(value):
+    return json.dumps(value, ensure_ascii=False, separators=(',', ':'), allow_nan=False)
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--historical-root', required=True)
+    parser.add_argument('--output', required=True)
+    args = parser.parse_args()
+    original = Path(args.historical_root).resolve()
+    out = Path(args.output).resolve()
+    if original == ROOT or out.is_relative_to(original/'src'):
+        raise ValueError('Use the isolated source snapshot and a separate report directory')
+    manifest = json.loads((ROOT.parent/'snapshot_manifest.json').read_text())
+    assert manifest['source_root'] == str(original) and manifest['workspace'] == str(ROOT)
+    network = []
+
+    def blocked(*args, **kwargs):
+        network.append('blocked')
+        raise AssertionError('Offline Replay verification attempted network access')
+
+    protected = manifest['protected_original_files']
+    assert all(digest(original/name) == expected for name, expected in protected.items())
+    rows = []
+    with ExitStack() as stack:
+        for method in ('connect', 'connect_ex'):
+            stack.enter_context(patch.object(socket.socket, method, blocked))
+        stack.enter_context(patch('socket.create_connection', blocked))
+        stack.enter_context(patch('subprocess.Popen', side_effect=AssertionError('No model subprocesses')))
+        stack.enter_context(patch('dotenv.dotenv_values', side_effect=AssertionError('No credentials')))
+        from src.skill_evolution.v27.benchmarks.lmb import replay_input_view as view, prompting
+        from src.skill_evolution.v27.benchmarks.lmb.adapter import LMBAdapter
+        from src.skill_evolution.v27.benchmark import using_benchmark
+
+        assert Path(view.__file__).resolve().is_relative_to(ROOT)
+        campaign = original/'experiments/campaigns/v27_lmb53_actor49152_20261031_152036'
+        with using_benchmark(LMBAdapter()):
+            for number in range(1, 7):
+                rd = campaign/'rounds'/f'R{number:02}'/'replay'
+                messages = json.loads((rd/'base_messages.json').read_text())
+                request = json.loads((rd/'attempts/001/request.json').read_text())
+                assert request['body']['messages'] == messages
+                payload = json.loads(messages[1]['content'])
+                untouched = deepcopy(payload)
+                shared = view.model_input(payload)
+                restored = view.restore_initial(shared)
+                for run in restored['runs']:
+                    run['attempts'][0]['request_messages'] = deepcopy(run['initial']['messages'])
+                assert restored == payload and payload == untouched
+                for old_run, restored_run in zip(payload['runs'], restored['runs']):
+                    assert encoded(old_run['initial']['messages']) == encoded(restored_run['initial']['messages'])
+                    assert encoded(old_run['attempts'][0]['request_messages']) == encoded(restored_run['attempts'][0]['request_messages'])
+                bundle = json.loads((rd/'input.json').read_text())
+                new_messages = prompting._messages('replay', shared, bundle['background'])
+                usage = json.loads((rd/'attempts/001/response.json').read_text())['usage']
+                old, new = encoded(payload), encoded(shared)
+                row = {'round': f'R{number:02}', 'pairs': len(payload['pairs']), 'runs': len(payload['runs']),
+                       'original_user_chars': len(old), 'shared_user_chars': len(new),
+                       'original_user_utf8_bytes': len(old.encode()), 'shared_user_utf8_bytes': len(new.encode()),
+                       'original_message_chars': sum(len(m['content']) for m in messages),
+                       'shared_message_chars': sum(len(m['content']) for m in new_messages),
+                       'original_provider_prompt_tokens': usage['prompt_tokens'],
+                       'saved_user_chars': len(old)-len(new),
+                       'reduction_percent': 100*(len(old)-len(new))/len(old),
+                       'roundtrip_equal': True, 'input_unchanged': True,
+                       'source': str(rd/'base_messages.json'),
+                       'source_sha256': digest(rd/'base_messages.json'),
+                       'shared_user_sha256': hashlib.sha256(new.encode()).hexdigest()}
+                rows.append(row)
+    unchanged = all(digest(original/name) == expected for name, expected in protected.items())
+    pins = manifest['v28_pinned_dependencies']
+    pins_valid = all(digest(original/name) == expected for name, expected in pins.items())
+    assert unchanged and pins_valid and not network
+    old_total = sum(r['original_user_chars'] for r in rows)
+    new_total = sum(r['shared_user_chars'] for r in rows)
+    report = {'status': 'passed', 'variant': manifest['variant'], 'workspace': str(ROOT),
+              'input_view': view.INPUT_VIEW, 'prompt_version': prompting.PROMPT_VERSIONS['replay'],
+              'rounds': rows, 'totals': {'pairs': sum(r['pairs'] for r in rows),
+                  'runs': sum(r['runs'] for r in rows), 'original_user_chars': old_total,
+                  'shared_user_chars': new_total, 'saved_user_chars': old_total-new_total,
+                  'reduction_percent': 100*(old_total-new_total)/old_total,
+                  'original_provider_prompt_tokens': sum(r['original_provider_prompt_tokens'] for r in rows)},
+              'original_protected_files_checked': len(protected), 'original_sources_unchanged': unchanged,
+              'v28_pinned_dependencies_checked': len(pins), 'v28_pins_valid': pins_valid,
+              'network_connection_attempts': len(network), 'real_model_requests': 0,
+              'training_started': False, 'benchmark_evaluation_started': False,
+              'notes': ['Characters and UTF-8 bytes are exact, not provider token or cost estimates.',
+                        'Historical payloads are measured without resuming their recovery-aware campaigns.',
+                        'Model behavior and new training quality have not been evaluated.']}
+    out.mkdir(parents=True, exist_ok=True)
+    (out/'historical_replay_audit.json').write_text(json.dumps(report, ensure_ascii=False, indent=2)+'\n')
+    print(json.dumps({k: v for k, v in report.items() if k != 'rounds'}, ensure_ascii=False, indent=2))
+
+
+if __name__ == '__main__':
+    main()
