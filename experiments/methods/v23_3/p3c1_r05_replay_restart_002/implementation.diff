+read,save,now=run.read,run.save,run.now
+
+def verify():
+    from .parallel import verify as verify_parallel
+    verify_parallel()
+    for path,h in read(HERE/'recovery_freeze.json')['files'].items():assert run.previous.original.sha(path)==h,path
