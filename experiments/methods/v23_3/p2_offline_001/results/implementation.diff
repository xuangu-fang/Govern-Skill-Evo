+    if kind == "checks": value["plan"]["checks"][0]["update_ids"] = ["unknown"]
+    fake = Fake(value, content="{" if kind == "json" else None,
+                finish="length" if kind == "truncated" else "stop")
+    if kind == "exception":
+        def fake(*args):
