{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V23.4 multi-Knowledge contract v1 (P1 shape specification, not production validation)",
  "$ref": "#/$defs/replay",
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "memoryId": {"type": "string", "pattern": "^M[1-9][0-9]*$"},
    "revises": {"type": "array", "items": {"$ref": "#/$defs/memoryId"}, "uniqueItems": true},
    "evidence": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"},
      "description": "Resolution against supplied facts, edit/execution union and semantic support are separate checks."
    },
    "knowledgeItem": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {"text": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/evidence"}}
    },
    "knowledge": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/knowledgeItem"}},
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["revises", "knowledge"],
      "properties": {"revises": {"$ref": "#/$defs/revises"}, "knowledge": {"$ref": "#/$defs/knowledge"}}
    },
    "replay": {
      "type": "object", "additionalProperties": false, "required": ["entries"],
      "properties": {"entries": {"type": "array", "items": {"$ref": "#/$defs/proposal"}}}
    },
    "activeEntry": {
      "type": "object", "additionalProperties": false, "required": ["id", "knowledge"],
      "properties": {"id": {"$ref": "#/$defs/memoryId"}, "knowledge": {"$ref": "#/$defs/knowledge"}}
    },
    "archivedEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "context_id", "revises", "knowledge"],
      "properties": {
        "id": {"$ref": "#/$defs/memoryId"},
        "context_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "revises": {"$ref": "#/$defs/revises"},
        "knowledge": {"$ref": "#/$defs/knowledge"}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false, "required": ["entries", "sources"],
      "properties": {
        "entries": {"type": "array", "items": {"$ref": "#/$defs/activeEntry"}},
        "sources": {"type": "object", "additionalProperties": {"type": "object"},
          "description": "Existing full source contracts remain authoritative; this schema only specifies the outer shape."}
      }
    }
  }
}
